{
  "name": "@stellar-enclosure/stellar-enclosure-tianquan-jianshen-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/prepare-backend-references.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "pretypecheck": "node scripts/prepare-backend-references.mjs",
    "test": "vitest run",
    "pretest": "node scripts/prepare-backend-references.mjs",
    "verify:bundle": "node scripts/verify-browser-bundle.mjs",
    "verify:conformance": "node scripts/verify-tianquan-jianshen-conformance.mjs",
    "lint": "eslint .",
    "e2e": "playwright test",
    "e2e:external": "playwright test --config playwright.external.config.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@stellar-enclosure/stellar-enclosure-web-shared": "0.0.1",
    "@stellar-enclosure/stellar-enclosure-tianquan-jianshen-react-sdk": "0.0.1",
    "@tanstack/react-query": "^5.101.4",
    "antd": "^6.5.2",
    "i18next": "^24.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.0.0",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stellar-Enclosure/tianquan-jianshen-web.git"
  },
  "homepage": "https://github.com/Stellar-Enclosure/tianquan-jianshen-web#readme",
  "bugs": {
    "url": "https://github.com/Stellar-Enclosure/tianquan-jianshen-web/issues"
  },
  "overrides": {
    "react-i18next": {
      "typescript": "$typescript"
    }
  }
